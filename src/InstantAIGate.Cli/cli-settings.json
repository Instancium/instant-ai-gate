{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RemoteGateway": {
    "PublicUrl": "http://localhost:5000",
    "HubPath": "/hub/gateway",
    "AdminKey": "ChangeMeSuperSecureAdminApiKey123"
  },

  "ReleasePipeline": {
    "TargetBranch": "main",
    "ReleaseBranchPrefix": "release-prep/v",
    "AiModelId": "qwen3-vl-8b-instruct",
    "AllowedBranchPrefixes": [ "develop", "feat/", "fix/", "hotfix/", "rc/", "rfc/" ]
  },

  "InstantAIGate": {
    "Storage": {
      "ModelsDirectory": "C:\\models"
    },
    "HardwareProfiles": {
      "Default": {
        "GpuLayerCount": 99,
        "ContextSize": 4096,
        "BatchSize": 512,
        "Threads": 8,
        "FlashAttention": true,
        "KvCacheQuantization": "Q4_0"
      },
      "Embedding": {
        "GpuLayerCount": 99,
        "MainGPU": 0,
        "ContextSize": 8192,
        "BatchSize": 512,
        "Threads": 8,
        "FlashAttention": true,
        "Embeddings": true,
        "KvCacheQuantization": "Q8_0",
        "UseMemoryLock": false,
        "MaxContexts": 4
      },
      "CpuOnly": {
        "GpuLayerCount": 0,
        "ContextSize": 2048,
        "BatchSize": 128,
        "Threads": 16,
        "MainGPU": 0,
        "UseMemoryLock": false
      }
    }
  }
}