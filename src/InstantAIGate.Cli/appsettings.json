{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "InstantAIGate": {
    "Storage": {
      "ModelsDirectory": "C:\\models"
    },
    "HardwareProfiles": {
      "Default": {
        "GpuLayerCount": 99,
        "ContextSize": 4096,
        "BatchSize": 512,
        "Threads": 8,
        "MainGPU": 0,
        "UseMemoryLock": true
      },
      "CpuOnly": {
        "GpuLayerCount": 0,
        "ContextSize": 2048,
        "BatchSize": 128,
        "Threads": 16,
        "MainGPU": 0,
        "UseMemoryLock": false
      }
    }
  }
}