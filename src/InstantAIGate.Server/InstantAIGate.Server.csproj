    <LangVersion>12.0</LangVersion>
	<Version>1.0.20-rc.1</Version>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
	</ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InstantAIGate.Core\InstantAIGate.Core.csproj" />
