    <ProjectReference Include="..\InstantAIGate.SSR\InstantAIGate.SSR.csproj" />
  </ItemGroup>

	<ItemGroup>
		<Content Include="..\..\config\model_catalog.json" Link="config\model_catalog.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\deploy\windows-service\InstallService.ps1" Link="InstallService.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="..\..\deploy\windows-service\UninstallService.ps1" Link="UninstallService.ps1">
