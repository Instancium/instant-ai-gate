@namespace InstantAIGate.Dashboard.Components
@using System.Globalization
@using InstantAIGate.Core.Dtos.Status
@using InstantAIGate.Dashboard.Services

<section class="ux-panel">
    <header class="ux-panel-head">
        <h2 class="ux-panel-title">Memory Leak Radar (Hardware vs Application)</h2>
        @switch (ViewMode)
        {
            case HardwareViewMode.Gpu:
                <span class="ux-badge ux-badge-ok">@Snapshot!.Hardware.GpuProviderName</span>
                break;
            case HardwareViewMode.UnifiedMemory:
                <span class="ux-badge ux-badge-warn">CPU-only: VRAM telemetry unavailable</span>
                break;
            default:
                <span class="ux-badge">awaiting telemetry</span>
                break;
        }
    </header>

    @if (ViewMode == HardwareViewMode.NoTelemetry)
    {
        <p class="ux-panel-empty">Waiting for the first telemetry snapshot…</p>
    }
    else
    {
        @if (ViewMode == HardwareViewMode.UnifiedMemory)
        {
            <p class="ux-card-note">
                This host exposes no GPU telemetry, so model weights, KV caches and the native heap live in system RAM.
                No VRAM numbers are reported or estimated here.
            </p>
        }

        @if (ViewMode == HardwareViewMode.Gpu)
        {
            <div class="ux-bar-row">
                <span class="ux-bar-label">VRAM</span>
                <div class="ux-bar">
                    <div class="ux-bar-fill @GetBarClass(VramPercent)" style="width: @FormatPercent(VramPercent)%"></div>
                </div>
                <span class="ux-bar-value">@FormatBytes(Snapshot!.Hardware.VramUsedBytes) / @FormatBytes(Snapshot.Hardware.VramTotalBytes) (@FormatPercent(VramPercent)%)</span>
            </div>
        }
        <div class="ux-bar-row">
            <span class="ux-bar-label">RAM</span>
            <div class="ux-bar">
                <div class="ux-bar-fill @GetBarClass(HostRamPercent)" style="width: @FormatPercent(HostRamPercent)%"></div>
            </div>
            <span class="ux-bar-value">@FormatBytes(HostRamUsedBytes) / @FormatBytes(Snapshot!.Hardware.SystemTotalRamBytes) (@FormatPercent(HostRamPercent)%)</span>
        </div>

        <div class="ux-table-wrap">
            <table class="ux-table">
                <thead>
                    <tr>
                        <th>Metric</th>
                        <th class="ux-num">Value</th>
                        <th class="ux-num">Share</th>
                        <th>What it measures</th>
                    </tr>
                </thead>

                @if (ViewMode == HardwareViewMode.Gpu)
                {
                    <tbody>
                        <tr class="ux-table-group"><th colspan="4">VRAM (GPU)</th></tr>
                        <tr>
                            <td class="ux-metric-name">Device VRAM used</td>
                            <td class="ux-num">@FormatBytes(Snapshot!.Hardware.VramUsedBytes)</td>
                            <td class="ux-num">@FormatShare(Snapshot.Hardware.VramUsedBytes, Snapshot.Hardware.VramTotalBytes)</td>
                            <td class="ux-mean">Total video memory in use across all processes on the GPU.</td>
                        </tr>
                        <tr>
                            <td class="ux-metric-name">Process VRAM</td>
                            <td class="ux-num">@FormatBytes(Snapshot.Hardware.VramProcessUsedBytes)</td>
                            <td class="ux-num">@FormatShare(Snapshot.Hardware.VramProcessUsedBytes, Snapshot.Hardware.VramTotalBytes)</td>
                            <td class="ux-mean">Portion of VRAM attributed to the gateway process.</td>
                        </tr>
                        <tr>
                            <td class="ux-metric-name">Unaccounted VRAM delta</td>
                            <td class="ux-num">@FormatDeltaBytes(_report.UnaccountedVramDeltaBytes)</td>
                            <td class="ux-num">—</td>
                            <td class="ux-mean">Process VRAM minus weights and KV estimate; sustained growth signals a native leak.</td>
                        </tr>
                    </tbody>
                }

                <tbody>
                    <tr class="ux-table-group"><th colspan="4">Host RAM</th></tr>
                    <tr>
                        <td class="ux-metric-name">System RAM used</td>
                        <td class="ux-num">@FormatBytes(HostRamUsedBytes)</td>
                        <td class="ux-num">@FormatShare(HostRamUsedBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Physical RAM in use by the OS and all processes on this machine.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">System RAM available</td>
                        <td class="ux-num">@FormatBytes(Snapshot.Hardware.SystemAvailableRamBytes)</td>
                        <td class="ux-num">@FormatShare(Snapshot.Hardware.SystemAvailableRamBytes, Snapshot.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">RAM immediately available for new allocations.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">CPU usage</td>
                        <td class="ux-num">@FormatPercent(Snapshot.Hardware.CpuUsagePercent)%</td>
                        <td class="ux-num">—</td>
                        <td class="ux-mean">Gateway process CPU load averaged across all cores.</td>
                    </tr>
                </tbody>

                <tbody>
                    <tr class="ux-table-group"><th colspan="4">Gateway process</th></tr>
                    <tr>
                        <td class="ux-metric-name">Process working set</td>
                        <td class="ux-num">@FormatBytes(_report.ProcessWorkingSetBytes)</td>
                        <td class="ux-num">@FormatShare(_report.ProcessWorkingSetBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Physical RAM pages currently touched by the gateway process.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Process private bytes</td>
                        <td class="ux-num">@FormatBytes(_report.ProcessPrivateBytes)</td>
                        <td class="ux-num">@FormatShare(_report.ProcessPrivateBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Memory committed exclusively to the gateway process.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Managed heap (GC)</td>
                        <td class="ux-num">@FormatBytes(_report.ManagedHeapBytes)</td>
                        <td class="ux-num">@FormatShare(_report.ManagedHeapBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Allocated managed heap incl. uncollected garbage; rises between GCs by design. Leak signal = rising baseline right after a full GC, not the sawtooth.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Native heap (Private − GC)</td>
                        <td class="ux-num">@FormatBytes(_report.PrivateUnmanagedBytes)</td>
                        <td class="ux-num">@FormatShare(_report.PrivateUnmanagedBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">llama.cpp / mtmd allocations: weights, KV caches, compute arenas.</td>
                    </tr>
                </tbody>

                <tbody>
                    <tr class="ux-table-group"><th colspan="4">Gateway footprint (estimate)</th></tr>
                    <tr>
                        <td class="ux-metric-name">Model weights (loaded)</td>
                        <td class="ux-num">@FormatBytes(_report.TotalModelWeightsBytes)</td>
                        <td class="ux-num">@FormatShare(_report.TotalModelWeightsBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Sum of loaded GGUF weight sizes resident in memory.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">KV cache (allocated slots)</td>
                        <td class="ux-num">@FormatBytes(_report.EstimatedKvCacheBytes)</td>
                        <td class="ux-num">@FormatShare(_report.EstimatedKvCacheBytes, Snapshot!.Hardware.SystemTotalRamBytes)</td>
                        <td class="ux-mean">Estimated KV memory of allocated context slots (leases + pooled).</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Native delta beyond weights + KV</td>
                        <td class="ux-num">@FormatDeltaBytes(_report.PrivateUnmanagedBytes - _report.EstimatedGatewayVramBytes)</td>
                        <td class="ux-num">—</td>
                        <td class="ux-mean">Native heap minus weights and KV; sustained positive growth is the leak signal.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Allocated contexts</td>
                        <td class="ux-num">@_report.TotalAllocatedContexts</td>
                        <td class="ux-num">—</td>
                        <td class="ux-mean">Active leases plus idle pooled native contexts.</td>
                    </tr>
                    <tr>
                        <td class="ux-metric-name">Active sessions</td>
                        <td class="ux-num">@_report.ActiveSessionsCount</td>
                        <td class="ux-num">—</td>
                        <td class="ux-mean">Sessions currently registered on the gateway.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (_report.IsNativeRetentionSuspected && !string.IsNullOrWhiteSpace(_report.RetentionDiagnosticMessage))
        {
            <p class="ux-alert ux-alert-danger">@_report.RetentionDiagnosticMessage</p>
        }

        @if (ViewMode == HardwareViewMode.Gpu && _report.IsVramSpilloverRisk)
        {
            <p class="ux-alert ux-alert-warn">VRAM utilization above 95%: OS page spillover over PCIe may collapse eval TPS.</p>
        }

        @if (History is { Count: >= 2 })
        {
            <figure class="ux-graph">
                <svg viewBox="0 0 600 150" preserveAspectRatio="none" role="img" aria-label="Memory and context history">
                    <polygon class="ux-graph-area" points="@BuildMemoryAreaPoints()" />
                    <polyline class="ux-graph-line" points="@BuildMemoryLinePoints()" />
                    <polyline class="ux-graph-line-ctx" points="@BuildContextsLinePoints()" />
                </svg>
                <figcaption class="ux-legend">
                    <span class="ux-legend-item"><i class="ux-swatch ux-swatch-mem"></i>physical memory (VRAM or native heap)</span>
                    <span class="ux-legend-item"><i class="ux-swatch ux-swatch-ctx"></i>allocated contexts</span>
                </figcaption>
            </figure>
        }
    }
</section>

@code {
    private enum HardwareViewMode
    {
        NoTelemetry = 0,
        Gpu = 1,
        UnifiedMemory = 2
    }

    [Parameter] public DashboardTelemetrySnapshot? Snapshot { get; set; }

    [Parameter] public IReadOnlyList<DashboardTelemetrySnapshot>? History { get; set; }

    private MemoryLeakReport _report = new();

    protected override void OnParametersSet()
    {
        _report = MemoryLeakAnalyzer.Analyze(Snapshot, History);
    }

    /// <summary>
    /// Adaptive presentation mode. Why: on CPU-only hosts every VRAM probe legitimately
    /// reports zero, and rendering a permanent 0% bar looked like a broken control.
    /// </summary>
    private HardwareViewMode ViewMode => Snapshot is null
        ? HardwareViewMode.NoTelemetry
        : (Snapshot.Hardware.VramTotalBytes > 0 ? HardwareViewMode.Gpu : HardwareViewMode.UnifiedMemory);

    private double VramPercent
    {
        get
        {
            long total = Snapshot?.Hardware.VramTotalBytes ?? 0;
            return total > 0 ? Math.Clamp((double)(Snapshot?.Hardware.VramUsedBytes ?? 0) / total * 100.0, 0.0, 100.0) : 0.0;
        }
    }

    private long HostRamUsedBytes
    {
        get
        {
            long total = Snapshot?.Hardware.SystemTotalRamBytes ?? 0;
            long avail = Snapshot?.Hardware.SystemAvailableRamBytes ?? 0;
            return Math.Max(0, total - avail);
        }
    }

    private double HostRamPercent
    {
        get
        {
            long total = Snapshot?.Hardware.SystemTotalRamBytes ?? 0;
            return total > 0 ? Math.Clamp((double)HostRamUsedBytes / total * 100.0, 0.0, 100.0) : 0.0;
        }
    }

    private long PeakMemoryBytes
    {
        get
        {
            if (History is null || History.Count == 0)
            {
                return GetSampleMemoryBytes(Snapshot);
            }

            long max = 0;
            for (int i = 0; i < History.Count; i++)
            {
                long val = GetSampleMemoryBytes(History[i]);
                if (val > max) max = val;
            }

            return max;
        }
    }

    private int PeakContextsCount
    {
        get
        {
            int max = 4;
            if (History is not null)
            {
                for (int i = 0; i < History.Count; i++)
                {
                    int c = GetSampleContextsCount(History[i]);
                    if (c > max) max = c;
                }
            }

            return max;
        }
    }

    private long GetSampleMemoryBytes(DashboardTelemetrySnapshot? s)
    {
        if (s is null) return 0;
        if (s.Hardware.VramTotalBytes > 0)
        {
            return s.Hardware.VramProcessUsedBytes > 0
                ? s.Hardware.VramProcessUsedBytes
                : s.Hardware.VramUsedBytes;
        }

        long priv = s.Hardware.ProcessPrivateBytes > 0
            ? s.Hardware.ProcessPrivateBytes
            : s.Hardware.ProcessRamBytes;
        return Math.Max(0, priv - s.Hardware.ManagedHeapBytes);
    }

    private static int GetSampleContextsCount(DashboardTelemetrySnapshot? s)
    {
        if (s?.Models is null) return 0;
        int sum = 0;
        for (int i = 0; i < s.Models.Count; i++)
        {
            sum += s.Models[i].ActiveLeases + s.Models[i].IdlePooledContexts;
        }

        return sum;
    }

    private string BuildMemoryLinePoints()
    {
        if (History is null || History.Count < 2) return string.Empty;
        long maxMem = Math.Max(1, PeakMemoryBytes);
        return BuildPolyline(History.Count, i => (double)GetSampleMemoryBytes(History[i]) / maxMem);
    }

    private string BuildMemoryAreaPoints()
    {
        string line = BuildMemoryLinePoints();
        return string.IsNullOrEmpty(line) ? string.Empty : $"0,145 {line} 600,145";
    }

    private string BuildContextsLinePoints()
    {
        if (History is null || History.Count < 2) return string.Empty;
        int maxCtx = Math.Max(1, PeakContextsCount);
        return BuildPolyline(History.Count, i => (double)GetSampleContextsCount(History[i]) / maxCtx);
    }

    private static string BuildPolyline(int count, Func<int, double> normalizedValueSelector)
    {
        const double width = 600.0;
        const double topY = 15.0;
        const double bottomY = 145.0;
        double usableHeight = bottomY - topY;
        var parts = new string[count];
        for (int i = 0; i < count; i++)
        {
            double x = (double)i / (count - 1) * width;
            double ratio = Math.Clamp(normalizedValueSelector(i), 0.0, 1.0);
            double y = bottomY - (ratio * usableHeight);
            parts[i] = string.Create(CultureInfo.InvariantCulture, $"{x:F1},{y:F1}");
        }

        return string.Join(' ', parts);
    }

    private static string GetBarClass(double percent) =>
        percent >= 95.0 ? "danger" : (percent >= 80.0 ? "warn" : "ok");

    private static string FormatPercent(double value) =>
        Math.Clamp(value, 0.0, 100.0).ToString("F1", CultureInfo.InvariantCulture);

    private static string FormatShare(long part, long total) =>
        total > 0 ? $"{FormatPercent(Math.Clamp((double)part / total * 100.0, 0.0, 100.0))}%" : "—";

    private static string FormatDeltaBytes(long bytes) =>
        (bytes < 0 ? "-" : string.Empty) + FormatBytes(Math.Abs(bytes));

    private static string FormatBytes(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        double value = bytes;
        int unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        return string.Create(CultureInfo.InvariantCulture, $"{value:0.##} {units[unit]}");
    }
}